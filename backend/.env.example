# Copia a backend/.env. El backend carga este archivo al arrancar.
# Nunca commitees backend/.env.

PORT=4000

# Voz del recorrido (OpenAI TTS). Vacío = el frontend usa el sintetizador del navegador.
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Postgres — solo para scripts de ingesta del maintainer (refreshDiario, ingest*).
# El mapa curado no requiere base de datos.
# DATABASE_URL=postgres://centinela:password@localhost:5432/centinela
# PGHOST=localhost
# PGPORT=5432
# PGUSER=centinela
# PGPASSWORD=password
# PGDATABASE=centinela
