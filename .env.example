# Copia este archivo a backend/.env (el backend carga backend/.env).
# Nunca subas un .env real. Este archivo solo tiene placeholders.

# --- API ---
PORT=4000

# Voz del recorrido (OpenAI TTS). Déjalo vacío en local si usas el fallback del navegador.
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# --- Base de datos (opcional en local) ---
# El mapa curado vive en backend/src/data/curated y no necesita Postgres.
# DATABASE_URL y las vars PG* son para scripts de ingesta del maintainer.
# No hay base de producción en este repositorio.

# DATABASE_URL=postgres://centinela:password@localhost:5432/centinela
# PGHOST=localhost
# PGPORT=5432
# PGUSER=centinela
# PGPASSWORD=password
# PGDATABASE=centinela
